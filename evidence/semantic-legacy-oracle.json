      "source": "$name:card;$color:red;.#{$name}{#{$name}-color:$color;content:\"name=#{$name}\"}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "quoted interpolation",
      "source": "$name:\"card\";.#{$name}{content:\"#{$name}\"}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "mixin interpolation",
      "source": "@mixin item($name,$value){.#{$name}{color:$value}}@include item(card,red)",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "interpolated nested parent",
      "source": "$state:hover;.a{&:#{$state}{color:red}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "supports group",
      "source": "@supports (display: grid){.a{display:grid}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "supports nested",
      "source": ".a{@supports (display: grid){display:grid}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "media nested selector",
      "source": ".a,.b{@media screen and (min-width: 20px){x:1;&:hover{x:2}}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "media content",
      "source": "@mixin media{@media screen{@content}}.a{@include media{x:1}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "layer group",
      "source": "@layer components {.a{x:1}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "font face",
      "source": "@font-face{font-family:demo;src:url(https://example.test/font.woff2)}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "nested properties",
      "source": ".a{font:{family:serif;size:12px}border:{color:red;style:solid}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "silent comments",
      "source": "// top\n.a{// inner\ncolor:red; // tail\nmargin:0}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "quote commas in arguments",
      "source": "@mixin m($a,$b){content:$a;background:$b}.a{@include m(\"a,b\",url(\"x,y\"))}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "parent reference remains attribute data",
      "source": ".a{[title=\"&\"]{content:\"&\"}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "empty mixin does not split rule",
      "source": "@mixin empty{}.a{x:1;@include empty;y:2}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "mixin overwriting",
      "source": "@mixin m{x:1}@mixin m{x:2}.a{@include m}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "unused default does not evaluate",
      "source": "$x:red;$x:$missing !default;.a{x:$x}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "custom property variable remains literal",
      "source": "$c:red;.a{--literal:$c;--expanded:#{$c}}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "font face bubbles out of selector",
      "source": ".a{@font-face{font-family:demo;src:url(x.woff)}color:red}",
      "ok": true,
      "expectedError": false,
      "detail": "same canonical CSS"
    },
    {
      "name": "error content outside mixin",
      "source": "@content;",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error unknown mixin",
      "source": ".a{@include missing}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error missing argument",
      "source": "@mixin m($a){x:$a}.a{@include m}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error too many arguments",
      "source": "@mixin m($a){x:$a}.a{@include m(1,2)}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error unknown keyword",
      "source": "@mixin m($a:1){x:$a}.a{@include m($b:2)}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error duplicate keyword",
      "source": "@mixin m($a:1){x:$a}.a{@include m($a:2,$a:3)}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error duplicate positional",
      "source": "@mixin m($a){x:$a}.a{@include m(1,$a:2)}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error duplicate parameter",
      "source": "@mixin m($a,$a){x:$a}.a{@include m(1,2)}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error invalid suffix",
      "source": "[a]{&-x{x:1}}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error invalid parent position",
      "source": ".a{span&{x:1}}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error mismatched brackets",
      "source": ".a{[x=(]){x:1}}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    },
    {
      "name": "error unknown interpolation variable",
      "source": ".#{$missing}{x:1}",
      "ok": true,
      "expectedError": true,
      "detail": "both reject"
    }
  ]
